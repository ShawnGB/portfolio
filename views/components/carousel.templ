package components

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/types"

// ProjectCarousel renders an auto-rotating carousel of featured projects
templ ProjectCarousel(pCtx i18n.PageContext, projects []types.FeaturedProject) {
	<div class="carousel-container">
		<div class="carousel" id="projects-carousel" data-total={ templ.EscapeString(string(rune(len(projects)))) }>
			for i, project := range projects {
				<div class={ "carousel-slide", templ.KV("active", i == 0) } data-index={ templ.EscapeString(string(rune(i))) }>
					<div class="featured-project-card">
						<div class="project-preview">
							<img
								src={ project.ImagePath }
								alt={ project.Name + " preview" }
								loading="lazy"
							/>
							<div class="project-status-badge" data-status={ project.Status }>
								if project.Status == "live" {
									🟢 { pCtx.T("projects.status.live") }
								} else if project.Status == "wip" {
									🟠 { pCtx.T("projects.status.wip") }
								} else if project.Status == "archived" {
									🔵 { pCtx.T("projects.status.archived") }
								}
							</div>
						</div>
						<div class="project-info">
							<h3>{ project.Name }</h3>
							<p class="project-description">{ project.Description }</p>
							<div class="tech-badges">
								for _, tech := range project.Technologies {
									<span class="tech-badge">{ tech }</span>
								}
							</div>
							<a
								href={ templ.URL(project.URL) }
								class="icon-link project-link"
								target="_blank"
								rel="noopener noreferrer"
							>
								@Icon("external", "20", "")
								{ pCtx.T("projects.carousel.viewLive") }
							</a>
						</div>
					</div>
				</div>
			}
		</div>

		<!-- Carousel Controls -->
		<button class="carousel-control prev" aria-label="Previous project" data-action="prev">
			@Icon("chevron-left", "32", "")
		</button>
		<button class="carousel-control next" aria-label="Next project" data-action="next">
			@Icon("chevron-right", "32", "")
		</button>

		<!-- Carousel Indicators -->
		<div class="carousel-indicators">
			for i := range projects {
				<button
					class={ "indicator", templ.KV("active", i == 0) }
					aria-label={ "Go to project " + templ.EscapeString(string(rune(i + 1))) }
					data-index={ templ.EscapeString(string(rune(i))) }
				></button>
			}
		</div>
	</div>

	<!-- Carousel JavaScript -->
	<script>
		(function() {
			let currentIndex = 0;
			let autoRotateInterval;
			const ROTATE_INTERVAL = 5000; // 5 seconds

			const carousel = document.getElementById('projects-carousel');
			const slides = carousel.querySelectorAll('.carousel-slide');
			const indicators = document.querySelectorAll('.carousel-indicators .indicator');
			const controls = document.querySelectorAll('.carousel-control');
			const totalSlides = slides.length;

			function showSlide(index) {
				// Remove active class from all slides and indicators
				slides.forEach(slide => slide.classList.remove('active'));
				indicators.forEach(ind => ind.classList.remove('active'));

				// Add active class to current slide and indicator
				slides[index].classList.add('active');
				indicators[index].classList.add('active');

				currentIndex = index;
			}

			function nextSlide() {
				const next = (currentIndex + 1) % totalSlides;
				showSlide(next);
			}

			function prevSlide() {
				const prev = (currentIndex - 1 + totalSlides) % totalSlides;
				showSlide(prev);
			}

			function startAutoRotate() {
				stopAutoRotate(); // Clear any existing interval
				autoRotateInterval = setInterval(nextSlide, ROTATE_INTERVAL);
			}

			function stopAutoRotate() {
				if (autoRotateInterval) {
					clearInterval(autoRotateInterval);
				}
			}

			// Event listeners for controls
			controls.forEach(control => {
				control.addEventListener('click', function() {
					stopAutoRotate();
					const action = this.getAttribute('data-action');
					if (action === 'next') {
						nextSlide();
					} else {
						prevSlide();
					}
					startAutoRotate();
				});
			});

			// Event listeners for indicators
			indicators.forEach((indicator, idx) => {
				indicator.addEventListener('click', function() {
					stopAutoRotate();
					showSlide(idx);
					startAutoRotate();
				});
			});

			// Pause auto-rotation on hover
			carousel.addEventListener('mouseenter', stopAutoRotate);
			carousel.addEventListener('mouseleave', startAutoRotate);

			// Start auto-rotation
			startAutoRotate();
		})();
	</script>
}
