templ IconCheck() {
	<polyline points="20 6 9 17 4 12"/>
}

// BrandIcon renders a brand/technology logo. Uses fill="currentColor" (not stroke).
// SVG paths sourced from simpleicons.org (CC0 licensed).
templ BrandIcon(name string, size string) {
	<svg class={ "icon icon-brand-" + name } width={ size } height={ size } viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
		if name == "typescript" {
			@BrandIconTypeScript()
		} else if name == "javascript" {
			@BrandIconJavaScript()
		} else if name == "go" {
			@BrandIconGo()
		} else if name == "python" {
			@BrandIconPython()
		} else if name == "react" {
			@BrandIconReact()
		} else if name == "nextdotjs" {
			@BrandIconNextjs()
		} else if name == "tailwindcss" {
			@BrandIconTailwind()
		} else if name == "htmx" {
			@BrandIconHTMX()
		} else if name == "nestjs" {
			@BrandIconNestJS()
		} else if name == "express" {
			@BrandIconExpress()
		} else if name == "fastapi" {
			@BrandIconFastAPI()
		} else if name == "bun" {
			@BrandIconBun()
		} else if name == "docker" {
			@BrandIconDocker()
		} else if name == "postgresql" {
			@BrandIconPostgreSQL()
		} else if name == "git" {
			@BrandIconGit()
		} else if name == "vitest" {
			@BrandIconVitest()
		}
	</svg>
}

