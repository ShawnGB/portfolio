package pages

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/views/layouts"
import "mymodules/gofolio/views/components"

templ projectsIntro(pCtx i18n.PageContext) {
	<p>{ pCtx.T("projects.intro.p1") }</p>
}

templ Projects(pCtx i18n.PageContext) {
	@layouts.SubpageTemplate(pCtx, "projects.title", projectsIntro(pCtx), "projects.pageTitle", "projects.pageMetaDescription") {
		<div class="grid-section projects-featured major-break">
			<div class="featured-hero">
				<img src="/static/images/projects/uskillity-preview.png" alt={ pCtx.T("projects.uskillity.imageAlt") } class="featured-screenshot"/>
				<div class="featured-overlay">
					<p class="label-mono">{ pCtx.T("projects.labels.sideProject") }</p>
					<h2>{ pCtx.T("projects.uskillity.title") }</h2>
				</div>
			</div>
			<div class="featured-details">
				<p>{ pCtx.T("projects.uskillity.description") }</p>
				<div class="featured-meta">
					<span class="stack">{ pCtx.T("projects.uskillity.stack.value") }</span>
					<div class="project-cta">
						<a href="https://github.com/ShawnGB/skillity-mono-bun" target="_blank" rel="noopener noreferrer">
							{ pCtx.T("projects.links.viewOnGithub") }
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="grid-section projects-featured">
			<div class="featured-hero">
				<img src="/static/images/projects/my-portfolio.png" alt={ pCtx.T("projects.currentProject.imageAlt") } class="featured-screenshot"/>
				<div class="featured-overlay">
					<p class="label-mono">{ pCtx.T("projects.labels.currentProject") }</p>
					<h2>{ pCtx.T("projects.currentProject.title") }</h2>
				</div>
			</div>
			<div class="featured-details">
				<p>{ pCtx.T("projects.currentProject.description") }</p>
				<div class="featured-meta">
					<span class="stack">{ pCtx.T("projects.currentProject.stack.value") }</span>
					<div class="project-cta">
						<a href="https://github.com/ShawnGB/portfolioingo" target="_blank" rel="noopener noreferrer">
							{ pCtx.T("projects.links.viewOnGithub") }
						</a>
					</div>
				</div>
			</div>
		</div>
		<div class="grid-section projects-client">
			<div class="grid-row">
				<div class="grid-col-7">
					<h2>{ pCtx.T("projects.section02.title") }</h2>
					<p class="label-mono">{ pCtx.T("projects.labels.photographyPortfolio") }</p>
					<h3>{ pCtx.T("projects.websitesBuilt.jessebecker.name") }</h3>
					<p>{ pCtx.T("projects.websitesBuilt.jessebecker.description") }</p>
					<a href="http://www.jessebecker.com/" class="cta-link" target="_blank" rel="noopener noreferrer">{ pCtx.T("projects.links.visitSite") }</a>
				</div>
				<div class="grid-col-5">
					<div class="client-image-tall">
						<img src="/static/images/projects/jesse-becker-preview.png" alt={ pCtx.T("projects.websitesBuilt.jessebecker.imageAlt") }/>
					</div>
				</div>
			</div>
			<h3>{ pCtx.T("projects.section02.otherWork") }</h3>
			<div class="grid-row other-work-grid">
				<div class="grid-col-4">
					<p class="label-mono">{ pCtx.T("projects.labels.wordpressPortfolio") }</p>
					<h4>{ pCtx.T("projects.websitesBuilt.arinashanzev.name") }</h4>
					<p>{ pCtx.T("projects.websitesBuilt.arinashanzev.description") }</p>
					<a href="https://arinashanzev.com/" class="cta-link" target="_blank" rel="noopener noreferrer">{ pCtx.T("projects.links.visitSite") }</a>
				</div>
				<div class="grid-col-4">
					<p class="label-mono">{ pCtx.T("projects.labels.artistPortfolio") }</p>
					<h4>{ pCtx.T("projects.websitesBuilt.berndwolf.name") }</h4>
					<p>{ pCtx.T("projects.websitesBuilt.berndwolf.description") }</p>
					<a href="https://berndwolf.net/" class="cta-link" target="_blank" rel="noopener noreferrer">{ pCtx.T("projects.links.visitSite") }</a>
				</div>
				<div class="grid-col-4">
					<p class="label-mono">{ pCtx.T("projects.labels.festivalWebsite") }</p>
					<h4>{ pCtx.T("projects.websitesBuilt.evolveFestivalWebsite.name") }</h4>
					<p>{ pCtx.T("projects.websitesBuilt.evolveFestivalWebsite.description") }</p>
				</div>
			</div>
		</div>
		<div class="grid-section projects-explorations">
			<h2>{ pCtx.T("projects.section03.title") }</h2>
			<p class="lead">{ pCtx.T("projects.explorations.lead") }</p>
			<div class="grid-row explorations-grid">
				<div class="grid-col-6">
					<p class="label-mono">{ pCtx.T("projects.labels.reactSpa") }</p>
					<h4>{ pCtx.T("projects.websitesBuilt.oldPortfolio.name") }</h4>
					<p>{ pCtx.T("projects.websitesBuilt.oldPortfolio.description") }</p>
				</div>
			</div>
		</div>
		<div class="grid-section projects-background">
			<h2>{ pCtx.T("projects.section04.title") }</h2>
			<div class="background-inline">
				<span><strong>{ pCtx.T("projects.cultural.kultschaette.name") }</strong> — { pCtx.T("projects.cultural.kultschaette.p1") }</span>
				<span><strong>{ pCtx.T("projects.cultural.evolveFestivalSupport.name") }</strong> — { pCtx.T("projects.cultural.evolveFestivalSupport.p1") }</span>
				<span><strong>Film</strong> — { pCtx.T("projects.film.description") } <a href="https://www.crew-united.com/de/Shawn-Gordon-Becker_283693.html" class="cta-link" target="_blank" rel="noopener noreferrer">{ pCtx.T("projects.film.linkCrewUnitedText") }</a></span>
			</div>
		</div>
		<div class="grid-section">
			<div class="grid-row cta-footer-grid">
				<div class="cta-button-wrapper">
					<a href="/static/ShawnBeckerResume.pdf" class="cta-link with-icon download" target="_blank" rel="noopener noreferrer">
						@components.Icon("download", "24", "")
						{ pCtx.T("projects.links.downloadCV") }
					</a>
				</div>
				<div class="contact-sentence">
					<p>{ pCtx.T("projects.cta.orGetInTouch") } <a class="cta-link" href={ pCtx.CurrentLangLink("/contact") }>{ pCtx.T("projects.cta.contactLinkText") }</a></p>
				</div>
			</div>
		</div>
	}
}
