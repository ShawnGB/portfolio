package pages

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/utils"
import "strconv"
import "mymodules/gofolio/views/layouts"

type artsSection struct {
	Images []utils.Image
	Class  string
}

// artsLayout is the editorial rhythm of the gallery: each entry takes the
// next n images. Images beyond the layout are not shown (20.webp is a still
// of the closing video, which the page shows instead).
var artsLayout = []struct {
	n     int
	class string
}{
	{3, "arts-grid full-bleed"},
	{3, "arts-grid full-bleed"},
	{1, "arts-anchor arts-anchor--slim full-bleed"},
	{3, "arts-grid full-bleed"},
	{3, "arts-grid full-bleed"},
	{3, "arts-grid full-bleed"},
	{2, "arts-grid--halves full-bleed"},
}

// buildArtsSections distributes images over artsLayout without ever
// slicing out of range, so a missing or extra image can't break the page.
// The first image (01) is intentionally not shown in the gallery.
func buildArtsSections(imgs []utils.Image) []artsSection {
	if len(imgs) > 0 {
		imgs = imgs[1:]
	}
	var sections []artsSection
	take := func(n int, class string) {
		n = min(n, len(imgs))
		sections = append(sections, artsSection{Images: imgs[:n], Class: class})
		imgs = imgs[n:]
	}
	for _, l := range artsLayout {
		if len(imgs) == 0 {
			return sections
		}
		take(l.n, l.class)
	}
	return sections
}

templ artsImageSection(imgs []utils.Image, sectionClass string, pCtx i18n.PageContext) {
	if len(imgs) > 0 {
		<section class={ sectionClass }>
			for _, img := range imgs {
				if img.Width > 0 {
					<img src={ "/static/" + img.Path } alt={ pCtx.T("arts.gallery.imageAlt") } width={ strconv.Itoa(img.Width) } height={ strconv.Itoa(img.Height) } loading="lazy" decoding="async"/>
				} else {
					<img src={ "/static/" + img.Path } alt={ pCtx.T("arts.gallery.imageAlt") } loading="lazy" decoding="async"/>
				}
			}
		</section>
	}
}

templ Arts(images []utils.Image, pCtx i18n.PageContext) {
	@layouts.SubpageTemplate(pCtx, "arts.title", "arts.intro.p1", "arts.pageTitle", "arts.pageMetaDescription") {
		for _, s := range buildArtsSections(images) {
			@artsImageSection(s.Images, s.Class, pCtx)
		}
		<section class="arts-anchor arts-anchor--contained full-bleed">
			<video autoplay loop muted playsinline>
				<source src="/static/images/arts/IMG_3991.webm" type="video/webm"/>
				<source src="/static/images/arts/IMG_3991.mp4" type="video/mp4"/>
			</video>
		</section>
		<section class="arts-support">
			<p>{ pCtx.T("arts.support.text") }</p>
			<a href="https://ko-fi.com/shawngordonbecker" class="cta-link" target="_blank" rel="noopener">{ pCtx.T("arts.support.link") }</a>
		</section>
	}
}
