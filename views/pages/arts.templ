package pages

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/views/layouts"

func safeSlice(s []string, start, end int) []string {
	if start >= len(s) {
		return nil
	}
	if end > len(s) {
		end = len(s)
	}
	return s[start:end]
}

templ artsIntro(pCtx i18n.PageContext) {
	<p>{ pCtx.T("arts.intro.p1") }</p>
}

templ artsImageSection(imgs []string, sectionClass string, pCtx i18n.PageContext) {
	if len(imgs) > 0 {
		<section class={ sectionClass }>
			for _, img := range imgs {
				<img src={ "/static/" + img } alt={ pCtx.T("arts.gallery.imageAlt") }/>
			}
		</section>
	}
}

templ Arts(images []string, pCtx i18n.PageContext) {
	@layouts.SubpageTemplate(pCtx, "arts.title", artsIntro(pCtx), "arts.pageTitle", "arts.pageMetaDescription") {
		@artsImageSection(safeSlice(images, 1, 4), "arts-grid", pCtx)
		@artsImageSection(safeSlice(images, 4, 7), "arts-grid", pCtx)
		@artsImageSection(safeSlice(images, 7, 8), "arts-anchor arts-anchor--slim", pCtx)
		@artsImageSection(safeSlice(images, 8, 11), "arts-grid", pCtx)
		@artsImageSection(safeSlice(images, 11, 14), "arts-grid", pCtx)
		@artsImageSection(safeSlice(images, 14, 17), "arts-grid", pCtx)
		@artsImageSection(safeSlice(images, 17, 19), "arts-grid--halves", pCtx)
		<section class="arts-anchor arts-anchor--contained">
			<video autoplay loop muted playsinline>
				<source src="/static/images/arts/IMG_3991.MOV" type="video/quicktime"/>
			</video>
		</section>
		<section class="arts-sound">
			<img src="/static/images/website/shawn-playing-bass.jpg" alt="Playing bass guitar"/>
			<div class="arts-sound-text">
				<h2>{ pCtx.T("arts.sound.title") }</h2>
				<p><em>{ pCtx.T("arts.sound.text") }</em></p>
			</div>
		</section>
	}
}
