package pages

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/views/layouts"

templ Experience(pCtx i18n.PageContext) {
	@layouts.BaseHtml(pCtx, pCtx.T("experience.pageTitle"), pCtx.T("experience.pageMetaDescription")) {
		<div class="page-grid-container">
			<div class="grid-section experience-chapter-1">
				<div class="grid-col-12">
					<h2>{ pCtx.T("experience.chapter1.title") }</h2>
					<p class="label-mono">{ pCtx.T("experience.chapter1.subtitle") }</p>
				</div>
				<div class="grid--halves">
					<p>@pCtx.TRich("experience.chapter1.p1")</p>
					<p>@pCtx.TRich("experience.chapter1.p2")</p>
				</div>
				<div class="breakout-image-container">
					<img src="/static/images/experience/a-performance-at-keller.jpg" alt={ pCtx.T("experience.chapter1.image.alt") } loading="lazy" class="breakout-image-horizontal"/>
					<span class="image-caption">{ pCtx.T("experience.chapter1.image.caption") }</span>
				</div>
				<div class="grid-col-3">
					<p>@pCtx.TRich("experience.chapter1.p3")</p>
					<p>@pCtx.TRich("experience.chapter1.p4")</p>
					<p>@pCtx.TRich("experience.chapter1.p5")</p>
				</div>
				<div class="grid-col-12">
					<blockquote>{ pCtx.T("experience.chapter1.quote") }</blockquote>
				</div>
				<div class="grid-col-3">
					<p>@pCtx.TRich("experience.chapter1.p6")</p>
					<p>@pCtx.TRich("experience.chapter1.p7")</p>
					<p>@pCtx.TRich("experience.chapter1.p8")</p>
				</div>
			</div>
			<!-- Chapter 2: The Formalisation Years - VERTICAL SIDEBAR -->
			<div class="grid-section experience-chapter-2">
				<div class="grid-row">
					<div class="grid-col-12">
						<h2>{ pCtx.T("experience.chapter2.title") }</h2>
						<p class="label-mono">{ pCtx.T("experience.chapter2.subtitle") }</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-3">
						<figure class="vertical-image-strip-wrapper">
							<img src="/static/images/experience/building-uskillity.jpg" alt={ pCtx.T("experience.chapter2.image.alt") } loading="lazy" class="vertical-image-strip"/>
							<span class="image-caption">{ pCtx.T("experience.chapter2.image.caption") }</span>
						</figure>
					</div>
					<div class="grid-col-9">
						<p>@pCtx.TRich("experience.chapter2.p1")</p>
						<p>@pCtx.TRich("experience.chapter2.p2")</p>
						<p>@pCtx.TRich("experience.chapter2.p3")</p>
						<p>@pCtx.TRich("experience.chapter2.p4")</p>
						<p>@pCtx.TRich("experience.chapter2.p5")</p>
						<blockquote>{ pCtx.T("experience.chapter2.quote") }</blockquote>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<p>@pCtx.TRich("experience.chapter2.p6")</p>
						<p>@pCtx.TRich("experience.chapter2.p7")</p>
					</div>
				</div>
			</div>
			<!-- Chapter 3: Seeking Depth - FULL WIDTH IMAGE BETWEEN TEXT -->
			<div class="grid-section experience-chapter-3">
				<div class="grid-row">
					<div class="grid-col-12">
						<h2>{ pCtx.T("experience.chapter3.title") }</h2>
						<p class="label-mono">{ pCtx.T("experience.chapter3.subtitle") }</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-6">
						<p>@pCtx.TRich("experience.chapter3.p1")</p>
						<p>@pCtx.TRich("experience.chapter3.p2")</p>
						<p>@pCtx.TRich("experience.chapter3.p3")</p>
					</div>
					<div class="grid-col-6">
						<p>@pCtx.TRich("experience.chapter3.p4")</p>
						<p>@pCtx.TRich("experience.chapter3.p5")</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<figure class="full-width-image">
							<img src="/static/images/experience/work-from-anywhere.jpg" alt={ pCtx.T("experience.chapter3.image.alt") } loading="lazy"/>
							<span class="image-caption">{ pCtx.T("experience.chapter3.image.caption") }</span>
						</figure>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<p>@pCtx.TRich("experience.chapter3.p6")</p>
						<p>@pCtx.TRich("experience.chapter3.p7")</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<blockquote>{ pCtx.T("experience.chapter3.quote") }</blockquote>
					</div>
				</div>
			</div>
			<!-- CTA Footer -->
			@layouts.CTAFooter(pCtx, "experience.cta.downloadCV", "experience.cta.or", "experience.cta.viewProjects", "/projects")
		</div>
	}
}
