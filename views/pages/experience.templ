package pages

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/views/layouts"

templ Experience(pCtx i18n.PageContext) {
	@layouts.BaseHtml(pCtx, pCtx.T("experience.pageTitle"), pCtx.T("experience.pageMetaDescription")) {
		<div class="page-grid-container">
			<section class="grid-section experience-glance" aria-labelledby="experience-glance-title">
				<h2 id="experience-glance-title" class="label-mono glance-title">{ pCtx.T("experience.glance.title") }</h2>
				<ol class="glance-list">
					for _, n := range []string{"1", "2", "3", "4", "5", "6", "7", "8", "9"} {
						<li>
							<span class="glance-years">{ pCtx.T("experience.glance." + n + ".years") }</span>
							<span class="glance-role">{ pCtx.T("experience.glance." + n + ".role") }</span>
							<span class="glance-org">{ pCtx.T("experience.glance." + n + ".org") }</span>
						</li>
					}
				</ol>
			</section>
			<div class="grid-section experience-chapter-1">
				<h2>{ pCtx.T("experience.chapter1.title") }</h2>
				<p class="label-mono">{ pCtx.T("experience.chapter1.subtitle") }</p>
				<div class="grid--halves">
					<p>@pCtx.TRich("experience.chapter1.p1")
</p>
					<p>@pCtx.TRich("experience.chapter1.p2")
</p>
				</div>
				<div class="breakout-image-container">
					<img src="/static/images/experience/a-performance-at-keller.webp" alt={ pCtx.T("experience.chapter1.image.alt") } loading="lazy" class="breakout-image-horizontal"/>
					<span class="image-caption">{ pCtx.T("experience.chapter1.image.caption") }</span>
				</div>
				<p>@pCtx.TRich("experience.chapter1.p3")
</p>
				<p>@pCtx.TRich("experience.chapter1.p4")
</p>
				<p>@pCtx.TRich("experience.chapter1.p5")
</p>
				<blockquote>{ pCtx.T("experience.chapter1.quote") }</blockquote>
				<p>@pCtx.TRich("experience.chapter1.p6")
</p>
				<p>@pCtx.TRich("experience.chapter1.p7")
</p>
				<p>@pCtx.TRich("experience.chapter1.p8")
</p>
			</div>
			<!-- Chapter 2: The Formalisation Years - VERTICAL SIDEBAR -->
			<div class="grid-section experience-chapter-2">
				<div class="grid-row">
					<div class="grid-col-12">
						<h2>{ pCtx.T("experience.chapter2.title") }</h2>
						<p class="label-mono">{ pCtx.T("experience.chapter2.subtitle") }</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-3">
						<figure class="vertical-image-strip-wrapper">
							<img src="/static/images/experience/building-uskillity.webp" alt={ pCtx.T("experience.chapter2.image.alt") } loading="lazy" class="vertical-image-strip"/>
							<span class="image-caption">{ pCtx.T("experience.chapter2.image.caption") }</span>
						</figure>
					</div>
					<div class="grid-col-9">
						<p>@pCtx.TRich("experience.chapter2.p1")
</p>
						<p>@pCtx.TRich("experience.chapter2.p2")
</p>
						<p>@pCtx.TRich("experience.chapter2.p3")
</p>
						<p>@pCtx.TRich("experience.chapter2.p4")
</p>
						<p>@pCtx.TRich("experience.chapter2.p5")
</p>
						<blockquote>{ pCtx.T("experience.chapter2.quote") }</blockquote>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<p>@pCtx.TRich("experience.chapter2.p6")
</p>
						<p>@pCtx.TRich("experience.chapter2.p7")
</p>
					</div>
				</div>
			</div>
			<!-- Chapter 3: Seeking Depth - FULL WIDTH IMAGE BETWEEN TEXT -->
			<div class="grid-section experience-chapter-3">
				<div class="grid-row">
					<div class="grid-col-12">
						<h2>{ pCtx.T("experience.chapter3.title") }</h2>
						<p class="label-mono">{ pCtx.T("experience.chapter3.subtitle") }</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-6">
						<p>@pCtx.TRich("experience.chapter3.p1")
</p>
					</div>
					<div class="grid-col-6">
						<p>@pCtx.TRich("experience.chapter3.p2")
</p>
						<p>@pCtx.TRich("experience.chapter3.p3")
</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<figure class="full-width-image">
							<img src="/static/images/experience/work-from-anywhere.webp" alt={ pCtx.T("experience.chapter3.image.alt") } loading="lazy"/>
							<span class="image-caption">{ pCtx.T("experience.chapter3.image.caption") }</span>
						</figure>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<h3 class="label-mono lessons-title">{ pCtx.T("experience.chapter3.lessons.title") }</h3>
						<ul class="lessons-list">
							for _, n := range []string{"1", "2", "3", "4", "5", "6"} {
								<li>@pCtx.TRich("experience.chapter3.lessons." + n)
</li>
							}
						</ul>
						<p>@pCtx.TRich("experience.chapter3.p4")
</p>
					</div>
				</div>
				<div class="grid-row">
					<div class="grid-col-12">
						<blockquote>{ pCtx.T("experience.chapter3.quote") }</blockquote>
					</div>
				</div>
			</div>
			<!-- CTA Footer -->
			@layouts.CTAFooter(pCtx, "experience.cta.downloadCV", "experience.cta.or", "experience.cta.viewProjects", "/projects")
		</div>
	}
}
