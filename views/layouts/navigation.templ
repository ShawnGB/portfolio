package layouts

import "mymodules/gofolio/i18n"
import "mymodules/gofolio/views/components"

templ Navigation(pCtx i18n.PageContext) {
	<nav aria-label={ pCtx.T("nav.ariaLabel") }>
		<div class="nav-inner">
			<div class="nav-left-group">
				<a id="logo-link" href={ pCtx.CurrentLangLink("/") }>
					<h3>{ pCtx.T("nav.logo") }</h3>
				</a>
				<div class="language-switcher">
					<a href={ pCtx.LanguageSwitchURL("de") } class="lang-link">de</a>
					<span class="lang-separator">|</span>
					<a href={ pCtx.LanguageSwitchURL("en") } class="lang-link">en</a>
				</div>
			</div>
			<input type="checkbox" id="burger-toggle" class="burger-toggle-checkbox"/>
			<label for="burger-toggle" class="burger-menu-label" aria-label={ pCtx.T("nav.toggleMenu") }>
				<span class="burger-bar"></span>
				<span class="burger-bar"></span>
				<span class="burger-bar"></span>
			</label>
			<div class="nav-right-group">
				<ul class="nav-links" id="nav-links-list">
					<li><a href={ pCtx.CurrentLangLink("/about") } if pCtx.BasePath == "/about" { aria-current="page" class="nav-link--active" }>{ pCtx.T("nav.about") }</a></li>
					<li><a href={ pCtx.CurrentLangLink("/experience") } if pCtx.BasePath == "/experience" { aria-current="page" class="nav-link--active" }>{ pCtx.T("nav.experience") }</a></li>
					<li><a href={ pCtx.CurrentLangLink("/projects") } if pCtx.BasePath == "/projects" { aria-current="page" class="nav-link--active" }>{ pCtx.T("nav.projects") }</a></li>
					<li><a href={ pCtx.CurrentLangLink("/arts") } if pCtx.BasePath == "/arts" { aria-current="page" class="nav-link--active" }>{ pCtx.T("nav.arts") }</a></li>
					<li><a href={ pCtx.CurrentLangLink("/contact") } if pCtx.BasePath == "/contact" { aria-current="page" class="nav-link--active" }>{ pCtx.T("nav.contact") }</a></li>
				</ul>
				<div class="nav-utility-icons">
					<a href="https://github.com/ShawnGB" target="_blank" rel="noopener noreferrer" aria-label={ pCtx.T("nav.github.ariaLabel") }>
						@components.Icon("github", "20", "")
					</a>
					<a href="https://codeberg.org/ShawnGB" target="_blank" rel="noopener noreferrer" aria-label={ pCtx.T("nav.codeberg.ariaLabel") }>
						@components.Icon("codeberg", "20", "")
					</a>
					<a href="https://www.linkedin.com/in/shawn-gordon-b-540076b3/" target="_blank" rel="noopener noreferrer" aria-label={ pCtx.T("nav.linkedin.ariaLabel") }>
						@components.Icon("linkedin", "20", "")
					</a>
				</div>
			</div>
		</div>
	</nav>
}
