package layouts

import (
	"mymodules/gofolio/bundle"
	"mymodules/gofolio/i18n"
)

templ Head(pCtx i18n.PageContext, pagetitle string, pagedescription string) {
	<head>
		<!-- Basic Meta Tags -->
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<title>{ pagetitle }</title>
		<meta name="description" content={ pagedescription }/>
		<meta name="author" content="Shawn Becker"/>
		<meta name="robots" content="index, follow"/>
		<meta name="theme-color" content="#1a1a1a"/>
		<!-- Canonical URL -->
		<link rel="canonical" href={ string("https://shawnbecker.de" + string(pCtx.CurrentLangLink(pCtx.BasePath))) }/>
		<!-- Hreflang for Language Alternates -->
		<link rel="alternate" hreflang="en" href={ string("https://shawnbecker.de/en" + pCtx.BasePath) }/>
		<link rel="alternate" hreflang="de" href={ string("https://shawnbecker.de/de" + pCtx.BasePath) }/>
		<link rel="alternate" hreflang="x-default" href={ string("https://shawnbecker.de/en" + pCtx.BasePath) }/>
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website"/>
		<meta property="og:url" content={ string("https://shawnbecker.de" + string(pCtx.CurrentLangLink(pCtx.BasePath))) }/>
		<meta property="og:title" content={ pagetitle }/>
		<meta property="og:description" content={ pagedescription }/>
		<meta property="og:image" content="https://shawnbecker.de/static/images/website/og-image.jpg"/>
		<meta property="og:image:width" content="1200"/>
		<meta property="og:image:height" content="630"/>
		<meta property="og:image:alt" content="Shawn Gordon Becker – Building thoughtful digital products"/>
		if pCtx.ActiveLang == "en" {
			<meta property="og:locale" content="en_US"/>
			<meta property="og:locale:alternate" content="de_DE"/>
		} else {
			<meta property="og:locale" content="de_DE"/>
			<meta property="og:locale:alternate" content="en_US"/>
		}
		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image"/>
		<meta name="twitter:url" content={ string("https://shawnbecker.de" + string(pCtx.CurrentLangLink(pCtx.BasePath))) }/>
		<meta name="twitter:title" content={ pagetitle }/>
		<meta name="twitter:description" content={ pagedescription }/>
		<meta name="twitter:image" content="https://shawnbecker.de/static/images/website/og-image.jpg"/>
		<!-- Favicon -->
		<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
		<!-- Google Fonts - Inky Minimalism Typography -->
		<link rel="preconnect" href="https://fonts.googleapis.com"/>
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,wght@0,400;0,600;0,700;1,400;1,600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
		<!-- Stylesheets (versioned for cache-busting) -->
		<link rel="stylesheet" href={ "/static/styles.css?v=" + bundle.CSSVersion() }/>
		<!-- Scripts -->
		<script src="https://unpkg.com/htmx.org@1.9.10/dist/htmx.min.js" integrity="sha384-D1Kt99CQMDuVetoL1lrYwg5t+9QdHe7NLX/SoJYkXDFfX37iInKRy5xLSi8nO7UC" crossorigin="anonymous"></script>
		<!-- Structured Data (Schema.org JSON-LD) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "Person",
				"name": "Shawn Gordon Becker",
				"alternateName": "Shawn Becker",
				"givenName": "Shawn",
				"additionalName": "Gordon",
				"familyName": "Becker",
				"url": "https://shawnbecker.de",
				"image": "https://shawnbecker.de/static/images/website/shawn-hero.webp",
				"jobTitle": "Software Engineer",
				"description": "Software engineer in Berlin working across the TypeScript stack with a lean toward the backend (NestJS, Node.js, PostgreSQL); also builds with Go. Background in audio engineering and live events.",
				"knowsAbout": [
					"Backend Development",
					"TypeScript",
					"Node.js",
					"PostgreSQL",
					"Docker",
					"Go",
					"React",
					"Web Development",
					"Product Management"
				],
				"sameAs": [
					"https://github.com/ShawnGB",
					"https://codeberg.org/ShawnGB",
					"https://www.linkedin.com/in/shawn-gordon-b-540076b3/",
					"https://shawnbecker.de"
				],
				"address": {
					"@type": "PostalAddress",
					"addressLocality": "Berlin",
					"addressCountry": "DE"
				},
				"alumniOf": [
					{
						"@type": "EducationalOrganization",
						"name": "CODE University of Applied Sciences"
					},
					{
						"@type": "EducationalOrganization",
						"name": "National University of Ireland Maynooth"
					}
				],
				"nationality": {
					"@type": "Country",
					"name": "Germany"
				}
			}
		</script>
	</head>
}
